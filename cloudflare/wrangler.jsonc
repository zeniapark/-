{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanaro-cs-insight",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hanaro-cs-insight-db",
      "database_id": "60d8f1d5-e53a-4052-a26c-e55ec84673e8",
      "migrations_dir": "migrations"
    }
  ]
}
